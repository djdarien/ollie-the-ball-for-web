{
  "name": "ollie-the-ball",
  "version": "1.0.0",
  "description": "Adventures of Ollie the Ball: The Lost Coin Hunt — HTML5 remake",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "serve": "python3 -m http.server 8080",
    "prepare:www": "node scripts/prepare-www.js",
    "cap:sync": "npm run prepare:www && npx cap sync ios",
    "ios:open": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "cannon-es": "^0.20.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
